{% extends '@Contao/content_element/text.html.twig' %}

{# "Output SVG inline" (tl_content.svgInline): print the SVG markup instead of the <picture>,
   e.g. to animate it with CSS. The figure itself (link, caption) is rendered as usual. Falls
   back to the regular picture if the image is not an SVG or cannot be read. The markup is
   sanitised in Kiwi\Contao\CmxBundle\Twig\InlineSvgExtension. #}
{% block text_media %}
    {% set inline_svg_markup = image and data.svgInline|default ? inline_svg(data.singleSRC) : null %}
    {% set figure_attributes = attrs(figure_attributes|default).addClass('figure--inline-svg', inline_svg_markup) %}
    {{ parent() }}
{% endblock %}

{% block media %}
    {% if inline_svg_markup|default %}
        {{ inline_svg_markup }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
