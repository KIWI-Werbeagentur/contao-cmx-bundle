{% block content %}
    {% if not app.request().query.get('_clp') and (app.environment == "dev" or isPreview()) %}
        {% set attributes = attrs()
            .addClass('cmx--ui')
            .setIfExists('data-cmx-ui', article.id)
            .mergeWith(attributes|default)
        %}

        {% set badgeAttributes = attrs()
            .addClass('cmx--ui__badge')
            .mergeWith(badgeAttributes|default)
        %}

        <div{{ attributes }}>
            <div{{ badgeAttributes }}>
                <span class="cmx--ui__label">{{ article.title|upper }}</span>
                <div class="cmx--ui__item cmx--ui__item--edit">
                    <a href="/contao?do={{ article.type }}&table=tl_content&act=edit&id={{ article.id }}" target="__blank">
                        <svg style="flex-shrink:0" width="11" height="11" viewBox="0 0 10 10" fill="none"><path d="M7 1.5l1.5 1.5-5.5 5.5H1.5V7L7 1.5z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><line x1="5.8" y1="2.7" x2="7.3" y2="4.2" stroke="currentColor" stroke-width="1.2"/></svg>
                    </a>
                </div>
                <span class="cmx--ui__separator"></span>
                <div class="cmx--ui__item cmx--ui__item--copy">
                    <a href="/contao?do={{ article.type }}&id={{ article.id }}&act=paste&mode=copy&rt={{ csrf() }}">
                        <svg style="flex-shrink:0" width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3.5" y="3.5" width="6.5" height="6.5" rx=".8"/><path d="M1 7.5V1h6.5v2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                </div>
                <div class="cmx--ui__item cmx--ui__item--cut">
                    <a href="/contao?do={{ article.type }}&id={{ article.id }}&act=paste&mode=cut&rt={{ csrf() }}">
                        <svg style="flex-shrink:0" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12m8-8L8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/></svg>
                    </a>
                </div>
                {% if copiedArticle() %}
                    <div class="cmx--ui__item cmx--ui__item--insert">
                        <a href="/contao?do={{ article.type }}&id={{ copiedArticle() }}&act=copy&mode=1&pid={{ article.id }}&rt={{ csrf() }}" target="__blank">
                            <svg style="flex-shrink:0" width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="5.5" y1="1.5" x2="5.5" y2="9.5"/><line x1="1.5" y1="5.5" x2="9.5" y2="5.5"/></svg>
                        </a>
                    </div>
                {% endif %}
                <div class="cmx--ui__item cmx--ui__item--children">
                    <a href="/contao?do={{ article.type }}&table=tl_content&id={{ article.id }}" target="__blank">
                        <svg style="flex-shrink:0" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/><path d="M14 4h7m-7 5h7m-7 6h7m-7 5h7"/></svg>
                    </a>
                </div>
                <div class="cmx--ui__item cmx--ui__item--page">
                    <a href="/contao?do={{ article.type }}&pn={{ article.pid }}&rt={{ csrf() }}" target="__blank">
                        <svg style="flex-shrink:0" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M15 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V7Z"/></svg>
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
