{
    "name": "kiwi/contao-cmx",
    "keywords": ["contao", "cmx", "ux", "cms", "backend"],
    "type": "contao-bundle",
    "description": "This contao bundle contains several functionalities to enhance UX within the Contao CMS.",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Katrin Zimmermann",
            "homepage": "https://github.com/diekatrin"
        },
        {
            "name": "KIWI. Werbeagentur GmbH",
            "homepage": "https://www.kiwi.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "symfony/css-selector": "^7.4 || ^8.0",
        "contao/core-bundle": "^5.3",
        "enshrined/svg-sanitize": "^1.0",
        "symfony/uid": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "think-digital-agency/contao-live-preview": "Adds the CMX article actions to the live preview sidebar"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0",
        "think-digital-agency/contao-live-preview": "<3.1"
    },
    "autoload": {
        "psr-4" : {
            "Kiwi\\Contao\\CmxBundle\\" : "src/"
        }
    },
    "extra":{
        "contao-manager-plugin": "Kiwi\\Contao\\CmxBundle\\ContaoManager\\Plugin"
    }
}

